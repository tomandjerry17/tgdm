---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Thomas Martinez | Full-stack developer",
  description = "Full-stack developer with a security background.",
} = Astro.props;

const pathname = Astro.url.pathname;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="font-sans">
    <!-- Header -->
    <header class="p-4 bg-gray-100 shadow">
      <nav class="flex gap-4">
        <a href="/" class:list={["text-gray-700", { "font-bold text-blue-600": pathname === "/" }]}>Home</a>
        <a href="/projects" class:list={["text-gray-700", { "font-bold text-blue-600": pathname.startsWith("/projects") }]}>Projects</a>
        <a href="/certificates" class:list={["text-gray-700", { "font-bold text-blue-600": pathname.startsWith("/certificates") }]}>Certificates</a>
        <a href="/contact" class:list={["text-gray-700", { "font-bold text-blue-600": pathname.startsWith("/contact") }]}>Contact</a>
      </nav>
    </header>

    <!-- Page content -->
    <main class="mx-auto max-w-5xl px-6 py-16">
        <slot />
    </main>

    <!-- Footer -->
    <footer class="p-4 bg-gray-100 text-center text-sm text-gray-500">
      © {new Date().getFullYear()} Thomas. All rights reserved.
    </footer>
  </body>
</html>
