---
import { site } from "../data/site";
---

<section class="pb-16 pt-16 sm:pt-24">
  <p class="inline-flex items-center gap-2 rounded-full border border-gray-200 px-3 py-1 text-sm text-gray-600">
    <span class="h-2 w-2 rounded-full bg-blue-600"></span>
    Open to new opportunities
  </p>

  <h1 class="mt-6 text-4xl font-semibold tracking-tight sm:text-5xl">
    {site.name}
  </h1>
  <p class="mt-3 text-xl text-gray-600 sm:text-2xl">{site.role}</p>
  
  <p class="mt-6 max-w-2xl leading-7 text-gray-600">
    I build full-stack web apps with React, Node.js, and PostgreSQL, and I bring
    a security mindset from hands-on SOC analyst experience. I care about
    software that is reliable, secure, and easy to use.
  </p>

  <div class="mt-8 flex flex-wrap items-center gap-3">
    <a
      href={site.resume}
      class="rounded-md bg-gray-900 px-5 py-2.5 text-sm font-medium text-white transition hover:bg-gray-700"
    >
      Download resume
    </a>
    <a
      href={`mailto:${site.email}`}
      class="rounded-md border border-gray-300 px-5 py-2.5 text-sm font-medium transition hover:bg-gray-100"
    >
      Email me
    </a>
    <a
      href={site.github}
      target="_blank"
      rel="noopener noreferrer"
      class="px-2 py-2.5 text-sm font-medium text-gray-600 hover:text-gray-900"
    >
      GitHub
    </a>
    <a
      href={site.linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="px-2 py-2.5 text-sm font-medium text-gray-600 hover:text-gray-900"
    >
      LinkedIn
    </a>
  </div>
</section>