---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
}

const { id, eyebrow, title } = Astro.props;
---

<section id={id} class="scroll-mt-20 border-t border-gray-200 py-16">
  <p class="text-sm font-medium text-blue-600">{eyebrow}</p>
  <h2 class="mt-1 text-2xl font-semibold tracking-tight sm:text-3xl">{title}</h2>
  <div class="mt-8">
    <slot />
  </div>
</section>