---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, summary, role, highlights, techStack, image, liveUrl, repoUrl } =
  project.data;
---

<article class="rounded-lg border border-gray-200 p-6">
  {
    image && (
      <img
        src={image}
        alt={`${title} screenshot`}
        loading="lazy"
        class="mb-5 aspect-video w-full rounded-md border border-gray-200 object-cover"
      />
    )
  }

  <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
    <h3 class="text-lg font-semibold">{title}</h3>
    <span class="text-sm text-gray-500">{role}</span>
  </div>

  <p class="mt-2 text-gray-600">{summary}</p>

  {
    highlights.length > 0 && (
      <ul class="mt-4 list-disc space-y-1 pl-5 text-sm text-gray-600">
        {highlights.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    )
  }

  <ul class="mt-5 flex flex-wrap gap-2">
    {
      techStack.map((tech) => (
        <li class="rounded border border-gray-200 px-2 py-1 text-xs text-gray-600">
          {tech}
        </li>
      ))
    }
  </ul>

  {
    (liveUrl || repoUrl) && (
      <div class="mt-5 flex gap-5 text-sm font-medium">
        {liveUrl && (
          <a
            href={liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-blue-600 hover:underline"
          >
            Live demo →
          </a>
        )}
        {repoUrl && (
          <a
            href={repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-700 hover:underline"
          >
            Source code →
          </a>
        )}
      </div>
    )
  }
</article>